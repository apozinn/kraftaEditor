[Desktop Entry]
Version=0.9.3.1
Type=Application
Name=Krafta Editor
Comment=A fast, lean code editor written in C++. Native widgets, LSP built in, 20+ languages, on Linux, Windows and macOS
Exec=kraftaEditor %F
Icon=kraftaEditor
Categories=Development;TextEditor;IDE;
Terminal=false
StartupNotify=true
MimeType=text/plain;text/x-c++;text/x-chdr;text/x-csrc;